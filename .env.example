# ============================================================
# SyncNode Environment Configuration
# Copy this file to .env and fill in your local values.
# NEVER commit .env with real credentials.
# ============================================================

# ---- Model / Ollama ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
SYNCNODE_MODEL_ID=gemma4:e4b
SYNCNODE_MODEL_PROVIDER=ollama
# Model call timeout in seconds
SYNCNODE_MODEL_TIMEOUT=300
# Max structured output repair attempts after the initial generation (MG-03: max 2)
SYNCNODE_MODEL_REPAIR_ATTEMPTS=2

# ---- Local GPU offload (see docs/INFERENCE_OPTIMIZATION.md) ----
# num_gpu: layers offloaded to GPU. 99 = all layers. 0 = CPU only.
SYNCNODE_GPU_LAYERS=99
# num_ctx: default context window (bounded well below the model max)
SYNCNODE_NUM_CTX=8192
# keep_alive: keep the model warm between workflow steps
SYNCNODE_KEEP_ALIVE=30m

# ---- Database ----
# SQLite (dev default): leave DATABASE_URL as shown below
# PostgreSQL (production): postgresql+asyncpg://user:pass@localhost/syncnode
DATABASE_URL=sqlite+aiosqlite:///./data/syncnode.db

# ---- ChromaDB / RAG ----
CHROMA_PERSIST_DIR=./data/rag_index
SYNCNODE_RAG_COLLECTION=syncnode_knowledge
SYNCNODE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Workspace ----
SYNCNODE_WORKSPACE_ROOT=C:\syncnode\workspace
SYNCNODE_DEMO_WORKSPACE=C:\syncnode\workspace\demo
SYNCNODE_DEMO_DOCUMENT=SyncNode_Verifier_Demo.docx

# ---- Demo / Test ----
SYNCNODE_DEMO_RECIPIENT=demo@example.com
SYNCNODE_DEMO_FAILURE=none

# ---- FastAPI ----
SYNCNODE_API_HOST=127.0.0.1
SYNCNODE_API_PORT=8000
SYNCNODE_DEBUG=true

# ---- Audit ----
SYNCNODE_AUDIT_CHAIN=sha256

# ---- Playwright ----
SYNCNODE_BROWSER_TYPE=chromium
SYNCNODE_BROWSER_HEADLESS=false

# ---- Logging ----
SYNCNODE_LOG_LEVEL=INFO
SYNCNODE_LOG_FORMAT=json

# ---- Policy ----
# Comma-separated list of tool risk classes requiring approval
SYNCNODE_APPROVAL_REQUIRED=EXTERNAL_COMMUNICATION,DESTRUCTIVE_LOCAL
